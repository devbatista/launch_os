#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

# Roda dentro do container:  docker compose run --rm web bin/setup
# Idempotente: pode ser executado a qualquer momento.
FileUtils.chdir APP_ROOT do
  puts "== Instalando gems =="
  system("bundle check") || system!("bundle install")

  puts "\n== Preparando banco (development e test) =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Limpando logs e temporários =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n== Pronto =="
  puts "Suba tudo com:  docker compose up"
  puts "App: http://localhost:3000 | Emails: http://localhost:3000/letter_opener | MinIO: http://localhost:9001"
end
