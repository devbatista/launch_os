<!DOCTYPE html>
<html lang="en" class="h-full bg-white scroll-smooth">
  <head>
    <title><%= content_for(:title) || "DevBatista" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Meta tags de SEO/OG, canonical e snippets de tracking (com nonce) vêm do controller/view via content_for. %>
    <%= yield :head %>

    <%= favicon_tags(@product) %>

    <%# Só Tailwind: actiontext.css (Trix) é do admin; o conteúdo do Action Text na LP usa `prose`. %>
    <%= stylesheet_link_tag "tailwind", "application" %>
    <%= javascript_importmap_tags "landing" %>
  </head>

  <%# Pixel e GA4 só com os ids configurados e fora do preview do admin (spec 10); carregados por modules/tracking.js, sem inline. %>
  <body class="h-full text-slate-900 antialiased"<% if meta_pixel_id || ga4_measurement_id %> data-module="tracking"<% end %><% if meta_pixel_id %> data-pixel-id="<%= meta_pixel_id %>"<% end %><% if ga4_measurement_id %> data-ga4-id="<%= ga4_measurement_id %>"<% end %>>
    <%= yield %>

    <%= render "shared/footer" %>
    <%= render "shared/consent_banner" unless @preview %>
    <%= yield :after_footer %>
  </body>
</html>
