<!DOCTYPE html>
<html lang="en" class="h-full bg-white scroll-smooth">
  <head>
    <title><%= content_for(:title) || "DevBatista" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Meta tags de SEO/OG, canonical e snippets de tracking (com nonce) vêm do controller/view via content_for. %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Só Tailwind: actiontext.css (Trix) é do admin; o conteúdo do Action Text na LP usa `prose`. %>
    <%= stylesheet_link_tag "tailwind", "application" %>
    <%= javascript_importmap_tags "landing" %>
  </head>

  <body class="h-full text-slate-900 antialiased">
    <%= yield %>

    <%= render "shared/footer" %>
    <%= yield :after_footer %>
  </body>
</html>
