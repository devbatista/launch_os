<!DOCTYPE html>
<html lang="pt-BR" class="h-full font-admin antialiased">
  <head>
    <title><%= content_for(:title) || "Launch OS — Admin" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Inter só no admin (painel interno); a LP usa a pilha do sistema. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">

    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags "application" %>
  </head>

  <body class="h-full bg-canvas text-ink-600">
    <% if authenticated? %>
      <div data-module="admin/theme admin/sidebar admin/confirm">
        <div class="adm-sidebar-backdrop" data-sidebar-close></div>
        <%= render "admin/shared/sidebar" %>
        <div class="adm-main">
          <%= render "admin/shared/header" %>
          <main class="adm-content">
            <%= render "admin/shared/flash" %>
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
  </body>
</html>
