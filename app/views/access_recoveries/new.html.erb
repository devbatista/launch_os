<%# Recuperação de acesso (spec 08): um campo de email; mensagem idêntica exista ou não a compra. %>
<% content_for :title, "Lost your download link? — DevBatista" %>
<% content_for :head do %><meta name="robots" content="noindex,nofollow"><% end %>

<main class="mx-auto max-w-lg px-4 py-12 sm:py-16">
  <section class="rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
    <h1 class="text-2xl font-bold sm:text-3xl">Lost your download link?</h1>
    <p class="mt-3 text-slate-600">Enter the email you used at checkout and we'll send you a fresh link. It works even if your previous link expired or hit its download limit.</p>

    <% if flash[:notice] %>
      <p class="mt-6 rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-emerald-900" role="status"><%= flash[:notice] %></p>
    <% end %>

    <%= form_with url: access_recover_path, method: :post, class: "mt-6 space-y-4" do |f| %>
      <%= f.hidden_field :form_token, value: @form_token %>
      <%# Honeypot: humanos não veem nem preenchem; bots preenchem tudo. %>
      <div class="hidden" aria-hidden="true">
        <%= f.label :website, "Website" %>
        <%= f.text_field :website, tabindex: -1, autocomplete: "off" %>
      </div>

      <div>
        <%= f.label :email, "Email address", class: "block text-sm font-semibold text-slate-800" %>
        <%= f.email_field :email, required: true, autocomplete: "email", autofocus: true, value: params[:email],
              class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-base focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-200" %>
        <% if @error %>
          <p class="mt-2 text-sm text-red-700" role="alert"><%= @error %></p>
        <% end %>
      </div>

      <%= f.button "Send me a new link", type: :submit, class: "w-full rounded-lg bg-emerald-700 px-6 py-3 font-bold text-white hover:bg-emerald-600" %>
    <% end %>

    <p class="mt-6 text-sm text-slate-500">Still stuck? Write to <a href="mailto:<%= support_email %>" class="underline"><%= support_email %></a> with the email you used at checkout.</p>
  </section>
</main>
