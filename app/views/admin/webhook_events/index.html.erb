<% content_for :title, "Webhook events — Launch OS" %>

<%= render "admin/shared/page_header", title: "Webhook events", subtitle: "Auditoria do que PayPal e Twilio enviaram; somente leitura." %>

<%= form_with url: admin_webhook_events_path, method: :get, class: "adm-filters" do |f| %>
  <div>
    <%= f.label :provider, "Provedor", class: label_classes %>
    <%= f.select :provider, options_for_select([ [ "Todos", "" ] ] + WebhookEvent::PROVIDERS.map { |p| [ p, p ] }, params[:provider]), {}, class: input_classes %>
  </div>
  <div>
    <%= f.label :status, "Status", class: label_classes %>
    <%= f.select :status, options_for_select([ [ "Todos", "" ] ] + AdminHelper::WEBHOOK_STATUS_BADGES.map { |k, (label, _)| [ label, k ] }, params[:status]), {}, class: input_classes %>
  </div>
  <%= f.button "Filtrar", type: :submit, class: button_classes(:primary) %>
  <%= link_to "Limpar", admin_webhook_events_path, class: button_classes(:secondary) %>
<% end %>

<% if @events.empty? %>
  <div class="adm-empty">Nenhum evento<%= " com esses filtros" if request.query_parameters.except("page").any? %>.</div>
<% else %>
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead>
        <tr>
          <th>Recebido</th>
          <th>Provedor</th>
          <th>Tipo</th>
          <th>Status</th>
          <th>Assinatura</th>
          <th>Pedido</th>
          <th>Erro</th>
        </tr>
      </thead>
      <tbody>
        <% @events.each do |event| %>
          <tr class="<%= 'adm-row-danger' if event.failed? %>">
            <td class="adm-num text-ink-400"><%= datetime_br(event.created_at) %></td>
            <td class="text-ink-900"><%= event.provider %></td>
            <td class="adm-mono"><%= link_to event.event_type, admin_webhook_event_path(event), class: "adm-link" %></td>
            <td><%= webhook_status_badge(event) %></td>
            <td><%= event.signature_valid? ? "✓" : "✗" %></td>
            <td class="adm-mono"><%= event.order ? link_to(short_id(event.order_id), admin_order_path(event.order), class: "adm-link") : "—" %></td>
            <td class="max-w-xs truncate text-xs" title="<%= event.error %>"><%= event.error || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "admin/shared/pagination", page: @page %>
  </div>
<% end %>
