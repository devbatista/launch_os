<% content_for :title, "#{@event.event_type} — Launch OS" %>

<%= render "admin/shared/page_header", title: @event.event_type, badges: webhook_status_badge(@event),
           subtitle: "#{@event.provider} · #{datetime_br(@event.created_at)} · assinatura #{@event.signature_valid? ? 'válida' : 'inválida'}",
           breadcrumb: [ [ "Webhook events", admin_webhook_events_path ], [ @event.event_type, nil ] ] do %>
  <% if @event.order %><%= link_to "Pedido #{short_id(@event.order_id)}", admin_order_path(@event.order), class: button_classes(:secondary) %><% end %>
<% end %>

<div class="grid gap-6">
  <section class="adm-card">
    <dl class="adm-dl">
      <%= dl_row("Id externo") { tag.span(@event.external_id, class: "adm-mono") } %>
      <%= dl_row "Processado em", datetime_br(@event.processed_at) %>
      <% if @event.error.present? %><%= dl_row("Erro / motivo") { tag.span(@event.error, class: "text-danger-600") } %><% end %>
    </dl>
  </section>

  <section class="adm-card">
    <h2 class="adm-card-title">Payload</h2>
    <pre class="adm-code"><%= JSON.pretty_generate(@event.payload) %></pre>
  </section>

  <section class="adm-card">
    <h2 class="adm-card-title">Headers</h2>
    <pre class="adm-code"><%= JSON.pretty_generate(@event.headers) %></pre>
  </section>
</div>
