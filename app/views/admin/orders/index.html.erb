<% content_for :title, "Pedidos — Launch OS" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Pedidos</h1>
</div>

<%= form_with url: admin_orders_path, method: :get, class: "mb-4 grid gap-3 rounded-lg border border-gray-200 bg-white p-4 text-sm md:grid-cols-6" do |f| %>
  <div class="md:col-span-2">
    <%= f.label :q, "Busca", class: "block text-xs font-semibold text-gray-500" %>
    <%= f.search_field :q, value: params[:q], placeholder: "email, PayPal order id ou capture id", class: input_classes %>
  </div>
  <div>
    <%= f.label :status, "Status", class: "block text-xs font-semibold text-gray-500" %>
    <%= f.select :status, options_for_select([ [ "Todos", "" ] ] + AdminHelper::ORDER_STATUS_BADGES.map { |k, (label, _)| [ label, k ] }, params[:status]), {}, class: input_classes %>
  </div>
  <div>
    <%= f.label :product_id, "Produto", class: "block text-xs font-semibold text-gray-500" %>
    <%= f.select :product_id, options_for_select([ [ "Todos", "" ] ] + @products.map { |p| [ p.name, p.id ] }, params[:product_id]), {}, class: input_classes %>
  </div>
  <div>
    <%= f.label :from, "De", class: "block text-xs font-semibold text-gray-500" %>
    <%= f.date_field :from, value: params[:from], class: input_classes %>
  </div>
  <div>
    <%= f.label :to, "Até", class: "block text-xs font-semibold text-gray-500" %>
    <%= f.date_field :to, value: params[:to], class: input_classes %>
  </div>
  <div class="md:col-span-6 flex gap-2">
    <%= f.button "Filtrar", type: :submit, class: button_classes(:primary) %>
    <%= link_to "Limpar", admin_orders_path, class: button_classes(:secondary) %>
  </div>
<% end %>

<% if @orders.empty? %>
  <p class="text-gray-600">Nenhum pedido<%= " com esses filtros" if request.query_parameters.except("page").any? %>.</p>
<% else %>
  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
        <tr>
          <th class="px-4 py-3">Pedido</th>
          <th class="px-4 py-3">Data</th>
          <th class="px-4 py-3">Produto</th>
          <th class="px-4 py-3">Cliente</th>
          <th class="px-4 py-3">Valor</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3">Canais</th>
          <th class="px-4 py-3">Origem</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @orders.each do |order| %>
          <tr class="<%= 'bg-red-50' if order.disputed? %>">
            <td class="px-4 py-3 font-mono text-xs"><%= link_to short_id(order.id), admin_order_path(order), class: "text-blue-700 hover:underline" %></td>
            <td class="px-4 py-3 text-gray-500 whitespace-nowrap"><%= datetime_br(order.created_at) %></td>
            <td class="px-4 py-3 text-gray-900"><%= order.product.name %></td>
            <td class="px-4 py-3 text-gray-900">
              <% if order.client %>
                <%= link_to order.client.email, admin_client_path(order.client), class: "hover:underline" %>
              <% else %>
                <span class="text-gray-400"><%= order.payer_email || "—" %></span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-gray-900 whitespace-nowrap"><%= money(order.amount_cents, order.currency) %></td>
            <td class="px-4 py-3"><%= order_status_badge(order) %></td>
            <td class="px-4 py-3 whitespace-nowrap"><%= channel_summary(order) %></td>
            <td class="px-4 py-3 text-xs text-gray-500"><%= [ order.utm_source, order.utm_campaign ].compact_blank.join(" / ").presence || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "admin/shared/pagination", page: @page %>
  </div>
<% end %>
