<% content_for :title, "Pedidos — Launch OS" %>

<%= render "admin/shared/page_header", title: "Pedidos", subtitle: "Cada pedido é um clique no PayPal; o status muda só pelo capture ou pelo webhook." %>

<%= form_with url: admin_orders_path, method: :get, class: "adm-filters grid md:grid-cols-6" do |f| %>
  <div class="md:col-span-2">
    <%= f.label :q, "Busca", class: label_classes %>
    <%= f.search_field :q, value: params[:q], placeholder: "email, PayPal order id ou capture id", class: input_classes %>
  </div>
  <div>
    <%= f.label :status, "Status", class: label_classes %>
    <%= f.select :status, options_for_select([ [ "Todos", "" ] ] + AdminHelper::ORDER_STATUS_BADGES.map { |k, (label, _)| [ label, k ] }, params[:status]), {}, class: input_classes %>
  </div>
  <div>
    <%= f.label :product_id, "Produto", class: label_classes %>
    <%= f.select :product_id, options_for_select([ [ "Todos", "" ] ] + @products.map { |p| [ p.name, p.id ] }, params[:product_id]), {}, class: input_classes %>
  </div>
  <div>
    <%= f.label :from, "De", class: label_classes %>
    <%= f.date_field :from, value: params[:from], class: input_classes %>
  </div>
  <div>
    <%= f.label :to, "Até", class: label_classes %>
    <%= f.date_field :to, value: params[:to], class: input_classes %>
  </div>
  <div class="md:col-span-6 flex gap-2">
    <%= f.button "Filtrar", type: :submit, class: button_classes(:primary) %>
    <%= link_to "Limpar", admin_orders_path, class: button_classes(:secondary) %>
  </div>
<% end %>

<% if @orders.empty? %>
  <div class="adm-empty">Nenhum pedido<%= " com esses filtros" if request.query_parameters.except("page").any? %>.</div>
<% else %>
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead>
        <tr>
          <th>Pedido</th>
          <th>Data</th>
          <th>Produto</th>
          <th>Cliente</th>
          <th>Valor</th>
          <th>Status</th>
          <th>Canais</th>
          <th>Origem</th>
        </tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <tr class="<%= 'adm-row-danger' if order.disputed? %>">
            <td class="adm-mono"><%= link_to short_id(order.id), admin_order_path(order), class: "adm-link" %></td>
            <td class="adm-num text-ink-400"><%= datetime_br(order.created_at) %></td>
            <td class="text-ink-900"><%= order.product.name %></td>
            <td class="text-ink-900">
              <% if order.client %>
                <%= link_to order.client.email, admin_client_path(order.client), class: "hover:underline" %>
              <% else %>
                <span class="text-ink-400"><%= order.payer_email || "—" %></span>
              <% end %>
            </td>
            <td class="adm-num text-ink-900"><%= money(order.amount_cents, order.currency) %></td>
            <td><%= order_status_badge(order) %></td>
            <td class="whitespace-nowrap"><%= channel_summary(order) %></td>
            <td class="text-xs"><%= [ order.utm_source, order.utm_campaign ].compact_blank.join(" / ").presence || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "admin/shared/pagination", page: @page %>
  </div>
<% end %>
