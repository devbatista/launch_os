<% content_for :title, "Pedido #{short_id(@order.id)} — Launch OS" %>

<%= render "admin/shared/page_header", title: "Pedido #{short_id(@order.id)}", badges: order_status_badge(@order),
           subtitle: "#{@order.product.name} · #{money(@order.amount_cents, @order.currency)} · #{datetime_br(@order.created_at)}",
           breadcrumb: [ [ "Pedidos", admin_orders_path ], [ short_id(@order.id), nil ] ] do %>
  <% if @order.paid? %>
    <%= button_to "Reenviar por email", resend_admin_order_path(@order, channel: "email"), class: button_classes(:secondary),
          form: { data: { confirm: "Reenviar o link de download por email? Se o token expirou ou atingiu o limite, um novo é gerado." } } %>
    <% if Delivery.whatsapp_enabled? && @order.client&.whatsapp_deliverable? %>
      <%= button_to "Reenviar por WhatsApp", resend_admin_order_path(@order, channel: "whatsapp"), class: button_classes(:secondary),
            form: { data: { confirm: "Reenviar o link por WhatsApp?" } } %>
    <% end %>
    <%= button_to "Regenerar token", regenerate_token_admin_order_path(@order), class: button_classes(:secondary),
          form: { data: { confirm: "Gerar um novo token? O link anterior deixa de funcionar e o contador volta a zero." } } %>
  <% end %>
  <% if @token && @token.revoked_at.nil? && !@order.refunded? %>
    <%= button_to "Revogar acesso", revoke_token_admin_order_path(@order), class: button_classes(:danger),
          form: { data: { confirm: "Revogar o acesso? O link de download passa a responder 410." } } %>
  <% end %>
  <% if @order.disputed? %>
    <%= button_to "Disputa: ganhamos (voltar a pago)", resolve_dispute_admin_order_path(@order, outcome: "paid"), class: button_classes(:primary),
          form: { data: { confirm: "Confirmar que a disputa foi resolvida a favor no PayPal? O pedido volta a pago e o token é regenerado." } } %>
    <%= button_to "Disputa: perdemos (reembolsar)", resolve_dispute_admin_order_path(@order, outcome: "refunded"), class: button_classes(:danger),
          form: { data: { confirm: "Confirmar que a disputa foi perdida no PayPal? O pedido vira reembolsado e o acesso é revogado." } } %>
  <% end %>
<% end %>

<% if @order.disputed? %>
  <div class="adm-alert adm-alert-danger"><%= icon(:alert, class: "mt-0.5 shrink-0") %><p><strong>Pedido em disputa</strong> desde <%= datetime_br(@order.disputed_at) %>. O acesso está revogado. Resolva no PayPal (Resolution Center) e registre o desfecho aqui — o webhook <code>CUSTOMER.DISPUTE.RESOLVED</code> também faz isso automaticamente.</p></div>
<% elsif @order.pending? && @order.pending_reason.present? %>
  <div class="adm-alert adm-alert-warning"><%= icon(:alert, class: "mt-0.5 shrink-0") %><p>Capture pendente no PayPal: <code><%= @order.pending_reason %></code>. O webhook <code>PAYMENT.CAPTURE.COMPLETED</code> confirma quando liberar.</p></div>
<% end %>

<div class="grid gap-6 lg:grid-cols-2">
  <section class="adm-card">
    <h2 class="adm-card-title">Pagamento</h2>
    <dl class="adm-dl">
      <%= dl_row("Status") { order_status_badge(@order) } %>
      <%= dl_row("Valor") { safe_join([ tag.span(money(@order.amount_cents, @order.currency), class: "adm-num"), " ", tag.span(@order.currency, class: "text-ink-400") ]) } %>
      <%= dl_row("PayPal order") { tag.span(@order.paypal_order_id || "—", class: "adm-mono") } %>
      <%= dl_row("PayPal capture") { tag.span(@order.paypal_capture_id || "—", class: "adm-mono") } %>
      <%= dl_row "Criado", datetime_br(@order.created_at) %>
      <%= dl_row "Pago em", datetime_br(@order.paid_at) %>
      <% if @order.refunded_at %><%= dl_row "Reembolsado em", datetime_br(@order.refunded_at) %><% end %>
      <% if @order.failed_at %><%= dl_row "Falhou em", datetime_br(@order.failed_at) %><% end %>
      <%= dl_row("IP") { tag.span(@order.ip_address || "—", class: "adm-mono") } %>
      <%= dl_row("User agent") { tag.span(@order.user_agent || "—", class: "text-xs text-ink-400 break-all") } %>
      <%= dl_row("Purchase (Pixel)") do %>
        <%= @order.purchase_tracked_at ? "marcado em #{datetime_br(@order.purchase_tracked_at)}" : "—" %>
        <span class="adm-mono text-ink-300">event_id <%= @order.event_id %></span>
      <% end %>
    </dl>
  </section>

  <section class="adm-card">
    <h2 class="adm-card-title">Cliente</h2>
    <% if @order.client %>
      <dl class="adm-dl">
        <%= dl_row("Nome") { link_to @order.client.name.presence || "—", admin_client_path(@order.client), class: "adm-link" } %>
        <%= dl_row "Email", @order.client.email %>
        <%= dl_row "País", @order.client.country %>
        <%= dl_row "Telefone", masked_phone(@order.client.phone) %>
        <%= dl_row("WhatsApp") do %>
          <% if @order.client.whatsapp_deliverable? %>opt-in em <%= datetime_br(@order.client.whatsapp_opt_in_at) %>
          <% elsif @order.client.whatsapp_opt_out_at %>opt-out em <%= datetime_br(@order.client.whatsapp_opt_out_at) %>
          <% else %>sem opt-in<% end %>
        <% end %>
      </dl>
    <% else %>
      <p class="text-sm text-ink-600">Sem cliente vinculado<%= " (pagador: #{@order.payer_email})" if @order.payer_email %>. O cliente é criado no capture ou no webhook de pagamento.</p>
    <% end %>

    <h2 class="adm-card-title">Token de download</h2>
    <% if @token %>
      <dl class="adm-dl">
        <%= dl_row("Token") { tag.span(masked_token(@token), class: "adm-mono") } %>
        <%= dl_row("Situação") do %>
          <% if @token.active? %><%= badge("Ativo", :success) %>
          <% else %><%= badge({ revoked: "Revogado", not_paid: "Aguardando pagamento", expired: "Expirado", limit_reached: "Limite atingido" }.fetch(@token.inactive_reason), :danger) %><% end %>
        <% end %>
        <%= dl_row "Expira em", datetime_br(@token.expires_at) %>
        <%= dl_row("Downloads") { tag.span("#{@token.download_count} / #{@token.max_downloads}", class: "adm-num") } %>
        <%= dl_row "Último download", datetime_br(@token.last_downloaded_at) %>
        <% if @token.revoked_at %><%= dl_row "Revogado em", datetime_br(@token.revoked_at) %><% end %>
      </dl>
    <% else %>
      <p class="text-sm text-ink-600">Nenhum token ainda — é criado quando o pagamento é confirmado.</p>
    <% end %>
  </section>

  <section class="adm-card">
    <h2 class="adm-card-title">Atribuição</h2>
    <% attribution = Order::ATTRIBUTION_FIELDS.filter_map { |f| [ f, @order.public_send(f) ] if @order.public_send(f).present? } %>
    <% if attribution.any? || @order.fbp.present? %>
      <dl class="adm-dl">
        <% attribution.each do |field, value| %>
          <%= dl_row(field) { tag.span(value, class: "break-all") } %>
        <% end %>
        <% if @order.fbp.present? %><%= dl_row("_fbp / _fbc") { tag.span([ @order.fbp, @order.fbc.presence ].compact.join(" / "), class: "adm-mono text-ink-400 break-all") } %><% end %>
      </dl>
    <% else %>
      <p class="text-sm text-ink-600">Sem dados de atribuição (acesso direto ou cookie ausente).</p>
    <% end %>
  </section>

  <section class="adm-card">
    <h2 class="adm-card-title">Mensagens</h2>
    <% if @message_logs.empty? %>
      <p class="text-sm text-ink-600">Nenhuma mensagem enviada.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="adm-table-inline">
          <thead><tr><th>Quando</th><th>Canal</th><th>Template</th><th>Status</th><th>Detalhe</th></tr></thead>
          <tbody>
            <% @message_logs.each do |log| %>
              <tr>
                <td class="adm-num text-ink-400"><%= datetime_br(log.created_at) %></td>
                <td><%= log.channel_email? ? "email" : "WhatsApp" %></td>
                <td class="adm-mono"><%= log.template %></td>
                <td><%= message_status_badge(log) %></td>
                <td class="text-xs">
                  <% if log.failed? || log.undelivered? %><span class="text-danger-600"><%= log.error_code %> <%= log.error_message %></span> (<%= log.attempts %> tentativa<%= "s" if log.attempts != 1 %>)
                  <% elsif log.sent_at %>enviado <%= datetime_br(log.sent_at) %><%= " · entregue #{datetime_br(log.delivered_at)}" if log.delivered_at %>
                  <% else %>—<% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <h2 class="adm-card-title">Webhooks</h2>
    <% if @webhook_events.empty? %>
      <p class="text-sm text-ink-600">Nenhum webhook vinculado a este pedido.</p>
    <% else %>
      <ul class="divide-y divide-line text-sm">
        <% @webhook_events.each do |event| %>
          <li class="flex flex-wrap items-center gap-2 py-2">
            <span class="adm-num text-ink-400"><%= datetime_br(event.created_at) %></span>
            <%= link_to event.event_type, admin_webhook_event_path(event), class: "adm-link adm-mono" %>
            <%= webhook_status_badge(event) %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
