<% content_for :title, "#{@product.name} — Launch OS" %>

<%= render "admin/shared/page_header", title: @product.name, badges: status_badge(@product), subtitle: @product.headline,
           breadcrumb: [ [ "Produtos", admin_products_path ], [ @product.name, nil ] ] do %>
  <%= link_to "Editar", edit_admin_product_path(@product), class: button_classes(:secondary) %>
  <%= link_to "Preview", preview_admin_product_path(@product), target: "_blank", rel: "noopener", class: button_classes(:secondary) %>
  <% if @product.published? %>
    <%= link_to @product.public_url, target: "_blank", rel: "noopener", class: button_classes(:secondary) do %>Ver ao vivo <%= icon(:external, class: "size-4!") %><% end %>
    <%= button_to "Despublicar", unpublish_admin_product_path(@product), method: :patch, class: button_classes(:secondary),
          form: { data: { confirm: "Despublicar? A landing page passa a responder 404." } } %>
  <% else %>
    <%= button_to "Publicar", publish_admin_product_path(@product), method: :patch, class: button_classes(:primary),
          disabled: !@product.publishable?, title: (@product.publishable? ? nil : "Falta: #{@product.missing_for_publish.join(', ')}") %>
  <% end %>
  <% unless @product.archived? %>
    <%= button_to "Arquivar", archive_admin_product_path(@product), method: :patch, class: button_classes(:secondary),
          form: { data: { confirm: "Arquivar? A landing page passa a responder 404; pedidos existentes continuam com acesso." } } %>
  <% end %>
  <% if @product.deletable? %>
    <%= button_to "Excluir", admin_product_path(@product), method: :delete, class: button_classes(:danger),
          form: { data: { confirm: "Excluir este rascunho? Não dá para desfazer." } } %>
  <% end %>
<% end %>

<% unless @product.publishable? %>
  <div class="adm-alert adm-alert-warning"><%= icon(:alert, class: "mt-0.5 shrink-0") %><p>Para publicar falta: <strong><%= @product.missing_for_publish.join(", ") %></strong>.</p></div>
<% end %>

<div class="grid gap-6 md:grid-cols-2">
  <section class="adm-card">
    <h2 class="adm-card-title">Landing page</h2>
    <dl class="adm-dl">
      <%= dl_row "URL pública" do %>
        <span class="flex items-center gap-2">
          <code class="adm-mono truncate"><%= @product.public_url %></code>
          <button type="button" class="<%= button_classes(:small) %>" data-module="admin/copy" data-copy-text="<%= @product.public_url %>">Copiar</button>
        </span>
      <% end %>
      <%= dl_row "Preço" do %>
        <span class="adm-num"><%= money(@product.price_cents, @product.currency) %></span>
        <% if @product.compare_at_price_cents %> <span class="text-ink-300 line-through"><%= money(@product.compare_at_price_cents, @product.currency) %></span><% end %>
      <% end %>
      <%= dl_row "Publicado em", datetime_br(@product.published_at) %>
      <%= dl_row "Blocos", "#{@product.benefits.size} benefícios · #{@product.testimonials.size} depoimentos · #{@product.faqs.size} FAQs" %>
      <%= dl_row "Arquivos" do %>
        PDF <%= @product.pdf_file.attached? ? "✓" : "—" %> · capa <%= @product.cover_image.attached? ? "✓" : "—" %> · mockup <%= @product.mockup_image.attached? ? "✓" : "—" %> · OG <%= @product.og_image.attached? ? "✓" : "—" %> · previews <%= @product.preview_images.count %>
      <% end %>
    </dl>
    <p class="adm-hint mt-4">O preview mostra a LP em qualquer status, com banner e compra desabilitada; "Ver ao vivo" abre a URL pública (só publicado).</p>
  </section>

  <section class="adm-card">
    <h2 class="adm-card-title">Pedidos</h2>
    <% paid = @product.orders.paid %>
    <dl class="adm-dl">
      <%= dl_row "Pagos" do %><span class="adm-num"><%= paid.count %> · <%= money(paid.sum(:amount_cents), @product.currency) %></span><% end %>
      <%= dl_row "Outros", "#{@product.orders.pending.count} pendentes · #{@product.orders.refunded.count} reembolsados · #{@product.orders.disputed.count} em disputa" %>
      <%= dl_row "Último pedido", datetime_br(@product.orders.maximum(:created_at)) %>
    </dl>
    <p class="mt-4"><%= link_to "Ver pedidos deste produto →", admin_orders_path(product_id: @product.id), class: "adm-link text-sm" %></p>
  </section>
</div>
