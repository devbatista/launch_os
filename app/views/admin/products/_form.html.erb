<%# Seções 1–3 e 5 da spec 05. Arquivos (seção 4) entram na 1.5; coleções (6–8) ficam em _collections. %>
<%= form_with model: [:admin, product], class: "space-y-8" do |form| %>
  <%= error_messages_for(product) %>

  <section class="rounded-lg border border-gray-200 bg-white p-5 space-y-4">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">Básico</h2>
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <%= form.label :name, "Nome", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :name, required: true, class: input_classes(product.errors[:name].any?) %>
      </div>
      <div>
        <%= form.label :slug, "Slug (URL)", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :slug, placeholder: "gerado do nome se vazio", pattern: "[a-z0-9-]+", class: input_classes(product.errors[:slug].any?) %>
        <p class="mt-1 text-xs text-gray-500">Letras minúsculas, números e hífens. <% if product.published? %><span class="text-yellow-700">Mudar o slug de um produto publicado quebra links já divulgados.</span><% end %></p>
      </div>
    </div>
    <% if product.persisted? %>
      <p class="text-sm text-gray-600">Status: <%= status_badge(product) %> <span class="text-gray-400">— muda pelos botões da página do produto.</span></p>
    <% end %>
  </section>

  <section class="rounded-lg border border-gray-200 bg-white p-5 space-y-4">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">Oferta</h2>
    <div>
      <%= form.label :headline, "Headline", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :headline, required: true, class: input_classes(product.errors[:headline].any?) %>
    </div>
    <div>
      <%= form.label :subheadline, "Subheadline", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :subheadline, class: input_classes %>
    </div>
    <div class="grid gap-4 md:grid-cols-4">
      <div>
        <%= form.label :price, "Preço (US$)", class: "block text-sm font-medium text-gray-700" %>
        <%= form.number_field :price, step: "0.01", min: "0.01", required: true, value: (product.price_cents ? product.price : nil), class: input_classes(product.errors[:price_cents].any?) %>
      </div>
      <div>
        <%= form.label :compare_at_price, "Preço \"de\" (US$)", class: "block text-sm font-medium text-gray-700" %>
        <%= form.number_field :compare_at_price, step: "0.01", min: "0.01", value: product.compare_at_price, class: input_classes(product.errors[:compare_at_price_cents].any?) %>
      </div>
      <div>
        <%= form.label :currency, "Moeda", class: "block text-sm font-medium text-gray-700" %>
        <%= form.select :currency, [ [ "USD", "USD" ] ], {}, class: input_classes %>
      </div>
      <div>
        <%= form.label :cta_text, "Texto do botão", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :cta_text, class: input_classes %>
      </div>
    </div>
  </section>

  <section class="rounded-lg border border-gray-200 bg-white p-5 space-y-4">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">Conteúdo</h2>
    <div>
      <%= form.label :description, "Descrição (o que está dentro)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.rich_text_area :description, class: "trix-content" %>
    </div>
    <div>
      <%= form.label :problem_text, "Bloco do problema", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_area :problem_text, rows: 4, class: input_classes %>
    </div>
    <div class="grid gap-4 md:grid-cols-[1fr_10rem]">
      <div>
        <%= form.label :guarantee_text, "Garantia", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_area :guarantee_text, rows: 3, class: input_classes %>
      </div>
      <div>
        <%= form.label :refund_days, "Dias para reembolso", class: "block text-sm font-medium text-gray-700" %>
        <%= form.number_field :refund_days, min: 0, class: input_classes(product.errors[:refund_days].any?) %>
      </div>
    </div>
  </section>

  <section class="rounded-lg border border-gray-200 bg-white p-5 space-y-4">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">SEO</h2>
    <div>
      <%= form.label :meta_title, "Meta title", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :meta_title, placeholder: "padrão: o nome do produto", class: input_classes %>
    </div>
    <div>
      <%= form.label :meta_description, "Meta description", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_area :meta_description, rows: 2, placeholder: "padrão: a subheadline", class: input_classes %>
    </div>
  </section>

  <div class="flex items-center gap-3">
    <%= form.submit(product.persisted? ? "Salvar" : "Criar produto", class: button_classes(:primary)) %>
    <%= link_to "Cancelar", (product.persisted? ? admin_product_path(product) : admin_products_path), class: button_classes(:secondary) %>
  </div>
<% end %>
