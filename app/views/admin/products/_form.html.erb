<%# Seções 1–5 da spec 05; coleções (6–8) ficam nos containers nested_list em edit.html.erb. %>
<%= form_with model: [:admin, product], class: "space-y-8", id: "product-form" do |form| %>
  <%= error_messages_for(product) %>

  <section class="adm-card space-y-4">
    <h2 class="adm-card-title">Básico</h2>
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <%= form.label :name, "Nome", class: label_classes %>
        <%= form.text_field :name, required: true, class: input_classes(product.errors[:name].any?) %>
      </div>
      <div>
        <%= form.label :slug, "Slug (URL)", class: label_classes %>
        <%= form.text_field :slug, placeholder: "gerado do nome se vazio", pattern: "[a-z0-9-]+", class: input_classes(product.errors[:slug].any?) %>
        <p class="adm-hint mt-1">Letras minúsculas, números e hífens. <% if product.published? %><span class="text-warning-700">Mudar o slug de um produto publicado quebra links já divulgados.</span><% end %></p>
      </div>
    </div>
    <% if product.persisted? %>
      <p class="text-sm text-ink-600">Status: <%= status_badge(product) %> <span class="text-ink-400">— muda pelos botões da página do produto.</span></p>
    <% end %>
  </section>

  <section class="adm-card space-y-4">
    <h2 class="adm-card-title">Oferta</h2>
    <div>
      <%= form.label :headline, "Headline", class: label_classes %>
      <%= form.text_field :headline, required: true, class: input_classes(product.errors[:headline].any?) %>
    </div>
    <div>
      <%= form.label :subheadline, "Subheadline", class: label_classes %>
      <%= form.text_field :subheadline, class: input_classes %>
    </div>
    <div class="grid gap-4 md:grid-cols-4">
      <div>
        <%= form.label :price, "Preço (US$)", class: label_classes %>
        <%= form.number_field :price, step: "0.01", min: "0.01", required: true, value: (product.price_cents ? product.price : nil), class: input_classes(product.errors[:price_cents].any?) %>
      </div>
      <div>
        <%= form.label :compare_at_price, "Preço \"de\" (US$)", class: label_classes %>
        <%= form.number_field :compare_at_price, step: "0.01", min: "0.01", value: product.compare_at_price, class: input_classes(product.errors[:compare_at_price_cents].any?) %>
      </div>
      <div>
        <%= form.label :currency, "Moeda", class: label_classes %>
        <%= form.select :currency, [ [ "USD", "USD" ] ], {}, class: input_classes %>
      </div>
      <div>
        <%= form.label :cta_text, "Texto do botão", class: label_classes %>
        <%= form.text_field :cta_text, class: input_classes %>
      </div>
    </div>
  </section>

  <section class="adm-card space-y-4">
    <h2 class="adm-card-title">Conteúdo</h2>
    <div>
      <%= form.label :description, "Descrição (o que está dentro)", class: label_classes %>
      <%= form.rich_text_area :description, class: "adm-input trix-content min-h-48" %>
    </div>
    <div>
      <%= form.label :problem_text, "Bloco do problema", class: label_classes %>
      <%= form.text_area :problem_text, rows: 4, class: input_classes %>
    </div>
    <div class="grid gap-4 md:grid-cols-[1fr_10rem]">
      <div>
        <%= form.label :guarantee_text, "Garantia", class: label_classes %>
        <%= form.text_area :guarantee_text, rows: 3, class: input_classes %>
      </div>
      <div>
        <%= form.label :refund_days, "Dias para reembolso", class: label_classes %>
        <%= form.number_field :refund_days, min: 0, class: input_classes(product.errors[:refund_days].any?) %>
      </div>
    </div>
  </section>

  <%# Arquivos: input + arquivo atual (com botão Remover que dispara um form DELETE fora deste form, via atributo `form`). %>
  <section id="files" class="adm-card space-y-5" data-module="admin/file_preview">
    <h2 class="adm-card-title">Arquivos</h2>
    <p class="adm-hint">PDF até 50 MB. Imagens JPEG, PNG ou WebP até 5 MB cada; até <%= Product::PREVIEW_IMAGES_MAX %> previews. Enviar um novo arquivo substitui o atual (exceto previews, que são acrescentados).</p>

    <%= render "admin/products/attachment_field", form:, product:, name: :pdf_file, label: "PDF do produto",
               hint: "O arquivo entregue ao comprador. Nunca fica em URL pública.", accept: Product::PDF_CONTENT_TYPE, max_bytes: Product::PDF_MAX_BYTES %>

    <div class="grid gap-5 md:grid-cols-3">
      <%= render "admin/products/attachment_field", form:, product:, name: :cover_image, label: "Capa",
                 hint: "Hero da LP (ou o mockup).", accept: Product::IMAGE_CONTENT_TYPES.join(","), max_bytes: Product::IMAGE_MAX_BYTES %>
      <%= render "admin/products/attachment_field", form:, product:, name: :mockup_image, label: "Mockup",
                 hint: "Imagem do produto em 3D/dispositivo.", accept: Product::IMAGE_CONTENT_TYPES.join(","), max_bytes: Product::IMAGE_MAX_BYTES %>
      <%= render "admin/products/attachment_field", form:, product:, name: :og_image, label: "Imagem OG",
                 hint: "Compartilhamento em redes (1200×630).", accept: Product::IMAGE_CONTENT_TYPES.join(","), max_bytes: Product::IMAGE_MAX_BYTES %>
    </div>

    <%= render "admin/products/attachment_field", form:, product:, name: :preview_images, label: "Previews (páginas de amostra)",
               hint: "Selecione uma ou mais imagens; elas são acrescentadas às existentes.", accept: Product::IMAGE_CONTENT_TYPES.join(","),
               max_bytes: Product::IMAGE_MAX_BYTES, multiple: true %>
  </section>

  <section class="adm-card space-y-4">
    <h2 class="adm-card-title">SEO</h2>
    <div>
      <%= form.label :meta_title, "Meta title", class: label_classes %>
      <%= form.text_field :meta_title, placeholder: "padrão: o nome do produto", class: input_classes %>
    </div>
    <div>
      <%= form.label :meta_description, "Meta description", class: label_classes %>
      <%= form.text_area :meta_description, rows: 2, placeholder: "padrão: a subheadline", class: input_classes %>
    </div>
  </section>

  <div class="adm-actions">
    <%= form.submit(product.persisted? ? "Salvar" : "Criar produto", class: button_classes(:primary)) %>
    <%= link_to "Cancelar", (product.persisted? ? admin_product_path(product) : admin_products_path), class: button_classes(:secondary) %>
  </div>
<% end %>

<%# Forms de remoção de arquivo, fora do form principal (HTML não permite forms aninhados); os botões
    "Remover" da seção Arquivos apontam para eles pelo atributo `form`. %>
<% if product.persisted? %>
  <% Product::ATTACHMENT_NAMES.each do |name| %>
    <% attachments_for(product, name).each do |attachment| %>
      <%= form_with url: admin_product_attachment_path(product, attachment), method: :delete, id: "remove-attachment-#{attachment.id}",
                    class: "hidden", data: { confirm: "Remover #{attachment.filename}? Não dá para desfazer." } do %><% end %>
    <% end %>
  <% end %>
<% end %>
