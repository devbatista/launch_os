<% content_for :title, "Editar #{@product.name} — Launch OS" %>

<%= render "admin/shared/page_header", title: "Editar produto", badges: status_badge(@product),
           breadcrumb: [ [ "Produtos", admin_products_path ], [ @product.name, admin_product_path(@product) ], [ "Editar", nil ] ] do %>
  <%= link_to "Ver produto", admin_product_path(@product), class: button_classes(:secondary) %>
<% end %>

<div class="max-w-4xl space-y-8">
  <%= render "form", product: @product %>

  <%# Coleções da LP: cada bloco é um container gerenciado por modules/admin/nested_list.js. %>
  <section id="benefits" class="adm-card">
    <h2 class="adm-card-title">Benefícios</h2>
    <div data-module="admin/nested_list">
      <%= render "admin/benefits/list", product: @product, items: @product.benefits, invalid_item: nil %>
    </div>
  </section>

  <section id="testimonials" class="adm-card">
    <h2 class="adm-card-title">Depoimentos</h2>
    <div data-module="admin/nested_list">
      <%= render "admin/testimonials/list", product: @product, items: @product.testimonials, invalid_item: nil %>
    </div>
  </section>

  <section id="faqs" class="adm-card">
    <h2 class="adm-card-title">FAQ</h2>
    <div data-module="admin/nested_list">
      <%= render "admin/faqs/list", product: @product, items: @product.faqs, invalid_item: nil %>
    </div>
  </section>
</div>
