<%# Um slot de arquivo: input de upload + arquivos atuais com botão Remover (form DELETE externo, via atributo `form`).
    Imagens atuais são servidas pelo proxy do Active Storage (funciona com o MinIO sem mexer no /etc/hosts).
    Locals: form, product, name, label, hint, accept, max_bytes, multiple (opcional). %>
<% multiple = local_assigns.fetch(:multiple, false) %>
<% current = attachments_for(product, name) %>
<div>
  <%= form.label name, label, class: label_classes %>
  <%= form.file_field name, accept:, multiple:, class: "block w-full text-sm text-ink-600 file:mr-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-hover file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-ink-700 hover:file:bg-line #{'text-danger-600' if product.errors[name].any?}",
                      data: { max_bytes: } %>
  <p class="adm-hint mt-1"><%= hint %></p>
  <div data-preview class="mt-2 space-y-1 text-xs"></div>

  <% if current.any? %>
    <ul class="mt-3 <%= multiple ? 'grid grid-cols-2 gap-3 sm:grid-cols-4' : 'space-y-2' %>">
      <% current.each do |attachment| %>
        <li class="flex items-center gap-3 rounded-md border border-line bg-hover p-2 text-sm <%= 'flex-col items-stretch' if multiple %>">
          <% if attachment.blob.image? %>
            <%= image_tag rails_storage_proxy_path(attachment), alt: attachment.filename.to_s, loading: "lazy",
                          class: (multiple ? "h-32 w-full rounded object-cover" : "h-16 w-16 rounded object-cover") %>
          <% else %>
            <span class="inline-flex h-16 w-16 shrink-0 items-center justify-center rounded bg-danger-50 text-xs font-semibold text-danger-700">PDF</span>
          <% end %>
          <div class="min-w-0 flex-1">
            <p class="truncate font-medium text-ink-900" title="<%= attachment.filename %>"><%= attachment.filename %></p>
            <p class="adm-hint"><%= file_size(attachment.byte_size) %></p>
          </div>
          <button type="submit" form="remove-attachment-<%= attachment.id %>" class="<%= button_classes(:small) %> text-danger-600!">Remover</button>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
