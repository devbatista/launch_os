<% content_for :title, "Produtos — Launch OS" %>

<%= render "admin/shared/page_header", title: "Produtos", subtitle: "Catálogo e landing pages." do %>
  <%= link_to "Novo produto", new_admin_product_path, class: button_classes(:primary) %>
<% end %>

<% if @products.empty? %>
  <div class="adm-empty">Nenhum produto ainda. <%= link_to "Cadastre o primeiro", new_admin_product_path, class: "adm-link" %>.</div>
<% else %>
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Slug</th>
          <th>Preço</th>
          <th>Status</th>
          <th>Atualizado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td class="font-medium text-ink-900"><%= link_to product.name, admin_product_path(product), class: "hover:underline" %></td>
            <td class="adm-mono">/<%= product.slug %></td>
            <td class="adm-num text-ink-900"><%= money(product.price_cents, product.currency) %></td>
            <td><%= status_badge(product) %></td>
            <td class="adm-num text-ink-400"><%= datetime_br(product.updated_at) %></td>
            <td class="text-right"><%= link_to "Editar", edit_admin_product_path(product), class: button_classes(:small) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
