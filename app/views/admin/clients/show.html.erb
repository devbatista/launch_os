<% content_for :title, "#{@client.name.presence || @client.email} — Launch OS" %>

<%= render "admin/shared/page_header", title: @client.name.presence || "Sem nome", subtitle: @client.email,
           breadcrumb: [ [ "Clientes", admin_clients_path ], [ @client.name.presence || @client.email, nil ] ] do %>
  <% if @client.whatsapp_opt_in? %>
    <%= button_to "Revogar opt-in de WhatsApp", revoke_whatsapp_opt_in_admin_client_path(@client), class: button_classes(:danger),
          form: { data: { confirm: "Revogar o opt-in? O cliente não receberá mais mensagens no WhatsApp (use quando ele pedir ao suporte)." } } %>
  <% end %>
<% end %>

<div class="grid gap-6 lg:grid-cols-2">
  <section class="adm-card">
    <h2 class="adm-card-title">Dados</h2>
    <dl class="adm-dl">
      <%= dl_row "Email", @client.email %>
      <%= dl_row "País", @client.country %>
      <%= dl_row("Telefone") { tag.span(masked_phone(@client.phone), class: "adm-mono") } %>
      <%= dl_row "Primeira compra", datetime_br(@client.first_purchase_at) %>
      <%= dl_row "Última compra", datetime_br(@client.last_purchase_at) %>
    </dl>

    <h2 class="adm-card-title">WhatsApp</h2>
    <% if @client.whatsapp_opt_in_at || @client.whatsapp_opt_out_at %>
      <dl class="adm-dl">
        <%= dl_row("Situação") { @client.whatsapp_deliverable? ? badge("Opt-in ativo", :success) : badge("Sem envio", :neutral) } %>
        <%= dl_row "Opt-in em", datetime_br(@client.whatsapp_opt_in_at) %>
        <%= dl_row("Texto aceito") { tag.span(@client.whatsapp_opt_in_text || "—", class: "text-xs text-ink-400") } %>
        <%= dl_row "Opt-out em", datetime_br(@client.whatsapp_opt_out_at) %>
      </dl>
    <% else %>
      <p class="text-sm text-ink-600">Sem opt-in de WhatsApp.</p>
    <% end %>
  </section>

  <section class="adm-card">
    <h2 class="adm-card-title">Pedidos</h2>
    <% if @orders.empty? %>
      <p class="text-sm text-ink-600">Nenhum pedido.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="adm-table-inline">
          <thead><tr><th>Pedido</th><th>Data</th><th>Produto</th><th>Valor</th><th>Status</th><th>Token</th></tr></thead>
          <tbody>
            <% @orders.each do |order| %>
              <tr>
                <td class="adm-mono"><%= link_to short_id(order.id), admin_order_path(order), class: "adm-link" %></td>
                <td class="adm-num text-ink-400"><%= datetime_br(order.created_at) %></td>
                <td class="text-ink-900"><%= order.product.name %></td>
                <td class="adm-num text-ink-900"><%= money(order.amount_cents, order.currency) %></td>
                <td><%= order_status_badge(order) %></td>
                <td class="text-xs"><%= order.download_token ? (order.download_token.active? ? "ativo · #{order.download_token.download_count}/#{order.download_token.max_downloads}" : "inativo") : "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <h2 class="adm-card-title">Mensagens</h2>
    <% if @message_logs.empty? %>
      <p class="text-sm text-ink-600">Nenhuma mensagem enviada.</p>
    <% else %>
      <ul class="divide-y divide-line text-sm">
        <% @message_logs.each do |log| %>
          <li class="flex flex-wrap items-center gap-2 py-2">
            <span class="adm-num text-ink-400"><%= datetime_br(log.created_at) %></span>
            <span><%= log.channel_email? ? "email" : "WhatsApp" %></span>
            <span class="adm-mono"><%= log.template %></span>
            <%= message_status_badge(log) %>
            <%= link_to "pedido #{short_id(log.order_id)}", admin_order_path(log.order_id), class: "adm-link text-xs" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
