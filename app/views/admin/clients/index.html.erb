<% content_for :title, "Clientes — Launch OS" %>

<%= render "admin/shared/page_header", title: "Clientes", subtitle: "Compradores identificados pelo email do PayPal." %>

<%= form_with url: admin_clients_path, method: :get, class: "adm-filters" do |f| %>
  <div class="min-w-64 grow">
    <%= f.label :q, "Busca", class: label_classes %>
    <%= f.search_field :q, value: params[:q], placeholder: "email ou nome", class: input_classes %>
  </div>
  <label class="flex items-center gap-2 pb-2 text-ink-600">
    <%= f.check_box :opt_in, { checked: params[:opt_in] == "1", class: "adm-checkbox" }, "1", "" %> Só com opt-in de WhatsApp
  </label>
  <%= f.button "Filtrar", type: :submit, class: button_classes(:primary) %>
  <%= link_to "Limpar", admin_clients_path, class: button_classes(:secondary) %>
<% end %>

<% if @clients.empty? %>
  <div class="adm-empty">Nenhum cliente<%= " com esses filtros" if request.query_parameters.except("page").any? %>.</div>
<% else %>
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Email</th>
          <th>Telefone</th>
          <th>WhatsApp</th>
          <th>Pedidos pagos</th>
          <th>Última compra</th>
        </tr>
      </thead>
      <tbody>
        <% @clients.each do |client| %>
          <tr>
            <td class="font-medium text-ink-900"><%= link_to client.name.presence || "—", admin_client_path(client), class: "hover:underline" %></td>
            <td><%= client.email %></td>
            <td class="adm-mono"><%= masked_phone(client.phone) %></td>
            <td><%= client.whatsapp_deliverable? ? badge("Opt-in", :success) : (client.whatsapp_opt_out_at ? badge("Opt-out", :neutral) : "—") %></td>
            <td class="adm-num text-ink-900"><%= client.paid_orders_count %></td>
            <td class="adm-num text-ink-400"><%= datetime_br(client.last_purchase_at) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "admin/shared/pagination", page: @page %>
  </div>
<% end %>
