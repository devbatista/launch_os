<% content_for :title, "Clientes — Launch OS" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Clientes</h1>
</div>

<%= form_with url: admin_clients_path, method: :get, class: "mb-4 flex flex-wrap items-end gap-3 rounded-lg border border-gray-200 bg-white p-4 text-sm" do |f| %>
  <div class="min-w-64 grow">
    <%= f.label :q, "Busca", class: "block text-xs font-semibold text-gray-500" %>
    <%= f.search_field :q, value: params[:q], placeholder: "email ou nome", class: input_classes %>
  </div>
  <label class="flex items-center gap-2 pb-2">
    <%= f.check_box :opt_in, { checked: params[:opt_in] == "1" }, "1", "" %> Só com opt-in de WhatsApp
  </label>
  <%= f.button "Filtrar", type: :submit, class: button_classes(:primary) %>
  <%= link_to "Limpar", admin_clients_path, class: button_classes(:secondary) %>
<% end %>

<% if @clients.empty? %>
  <p class="text-gray-600">Nenhum cliente<%= " com esses filtros" if request.query_parameters.except("page").any? %>.</p>
<% else %>
  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
        <tr>
          <th class="px-4 py-3">Nome</th>
          <th class="px-4 py-3">Email</th>
          <th class="px-4 py-3">Telefone</th>
          <th class="px-4 py-3">WhatsApp</th>
          <th class="px-4 py-3">Pedidos pagos</th>
          <th class="px-4 py-3">Última compra</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @clients.each do |client| %>
          <tr>
            <td class="px-4 py-3 font-medium text-gray-900"><%= link_to client.name.presence || "—", admin_client_path(client), class: "hover:underline" %></td>
            <td class="px-4 py-3 text-gray-900"><%= client.email %></td>
            <td class="px-4 py-3 font-mono text-xs text-gray-600"><%= masked_phone(client.phone) %></td>
            <td class="px-4 py-3"><%= client.whatsapp_deliverable? ? badge("Opt-in", "bg-green-100 text-green-800") : (client.whatsapp_opt_out_at ? badge("Opt-out", "bg-gray-100 text-gray-700") : "—") %></td>
            <td class="px-4 py-3 text-gray-900"><%= client.paid_orders_count %></td>
            <td class="px-4 py-3 text-gray-500"><%= datetime_br(client.last_purchase_at) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "admin/shared/pagination", page: @page %>
  </div>
<% end %>
