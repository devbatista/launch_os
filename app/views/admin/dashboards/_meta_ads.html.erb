<%# Gasto e resultado do Insights da Meta (spec 16) cruzados com os pedidos, por produto (via campanha) e por
    anúncio. Locals: d (Admin::Dashboard). %>
<h2 class="adm-card-title">Meta Ads
  <span class="ml-2 font-normal normal-case tracking-normal text-ink-300">
    <%= d.meta_synced_at ? "Insights atualizado em #{datetime_br(d.meta_synced_at)}" : "sem dados do Insights" %><%= " · campanhas vinculadas a #{d.product.name}" if d.product %>
  </span>
</h2>
<% if !d.meta_insights? %>
  <div class="adm-card">
    <p class="text-sm text-ink-600">
      <% if MetaAds.insights_enabled? %>
        Nenhum dado ainda: o sync roda a cada 6 h (veja a aba Cron em <%= link_to "/admin/sidekiq", "/admin/sidekiq/cron", class: "adm-link" %>).
      <% else %>
        Defina <code>META_ACCESS_TOKEN</code> e <code>META_AD_ACCOUNT_ID</code> para puxar gasto, cliques e eventos do Insights da Meta. Até lá, leia no Gerenciador de Anúncios.
      <% end %>
    </p>
  </div>
<% else %>
  <% meta_currency = d.meta_currency || "BRL" %>
  <% if d.meta_unassigned_spend_cents.positive? %>
    <div class="adm-alert adm-alert-warning mb-4">
      <%= icon(:alert, class: "mt-0.5 shrink-0") %>
      <p><%= money(d.meta_unassigned_spend_cents, meta_currency) %> do período em campanhas sem produto — não entram em nenhum produto.
        <%= link_to "Vincular em Campanhas Meta", admin_ad_campaigns_path, class: "adm-link" %></p>
    </div>
  <% end %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <%= render "stat", label: "Gasto", value: money(d.meta_spend_cents, meta_currency), hint: "CTR de link #{percent(d.meta_ctr, precision: 2)}" %>
    <%= render "stat", label: "Vendas da Meta", value: d.meta_sales, hint: "pedidos pagos com utm_source=#{Admin::Dashboard::META_UTM_SOURCE} · a Meta reporta #{d.meta_purchases}",
               tone: (:success if d.meta_sales.positive?) %>
    <%= render "stat", label: "CAC", value: money(d.meta_cac_cents, meta_currency), hint: "gasto ÷ vendas da Meta" %>
    <%= render "stat", label: "ROAS líquido", value: d.meta_roas ? "#{number_with_precision(d.meta_roas, precision: 2, separator: ',')}×" : "—",
               hint: "recebido no PayPal (#{meta_currency}) ÷ gasto", tone: (d.meta_roas >= 1 ? :success : :danger if d.meta_roas) %>
  </div>

  <% if d.product.nil? && d.meta_by_product.any? %>
    <section class="adm-card mt-4">
      <h2 class="adm-card-title">Por produto<span class="ml-2 font-normal normal-case tracking-normal text-ink-300">produto da campanha</span></h2>
      <div class="overflow-x-auto">
        <table class="adm-table-inline">
          <thead>
            <tr><th>Produto</th><th class="text-right">Gasto</th><th class="text-right">Vendas</th><th class="text-right">CAC</th><th class="text-right">ROAS líquido</th></tr>
          </thead>
          <tbody>
            <% d.meta_by_product.each do |row| %>
              <tr>
                <td>
                  <% if row[:product] %>
                    <%= link_to row[:product].name, admin_dashboard_path(product_id: row[:product].id, period: d.period, from: params[:from], to: params[:to]), class: "adm-link" %>
                  <% else %>
                    <span class="text-ink-400">Sem produto</span> · <%= link_to "vincular", admin_ad_campaigns_path, class: "adm-link" %>
                  <% end %>
                </td>
                <td class="adm-num text-right"><%= money(row[:spend_cents], meta_currency) %></td>
                <td class="adm-num text-right"><%= row[:sales] %></td>
                <td class="adm-num text-right"><%= money(row[:cac_cents], meta_currency) %></td>
                <td class="adm-num text-right"><%= row[:roas] ? "#{number_with_precision(row[:roas], precision: 2, separator: ',')}×" : "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <section class="adm-card mt-4">
    <h2 class="adm-card-title">Por anúncio<span class="ml-2 font-normal normal-case tracking-normal text-ink-300">nome do anúncio = utm_content</span></h2>
    <% if d.meta_ads.empty? %>
      <p class="text-sm text-ink-600">Nenhum anúncio com impressões no período.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="adm-table-inline">
          <thead>
            <tr>
              <th>Anúncio</th><th class="text-right">Gasto</th><th class="text-right">Impressões</th><th class="text-right">Cliques</th>
              <th class="text-right">CTR</th><th class="text-right">LP views</th><th class="text-right">Checkouts</th>
              <th class="text-right">Vendas</th><th class="text-right">CAC</th>
            </tr>
          </thead>
          <tbody>
            <% d.meta_ads.each do |ad| %>
              <tr>
                <td class="text-ink-900"><%= ad[:name] %></td>
                <td class="adm-num text-right"><%= money(ad[:spend_cents], meta_currency) %></td>
                <td class="adm-num text-right"><%= number_with_delimiter(ad[:impressions], delimiter: ".") %></td>
                <td class="adm-num text-right"><%= ad[:link_clicks] %></td>
                <td class="adm-num text-right"><%= percent(ad[:ctr], precision: 2) %></td>
                <td class="adm-num text-right"><%= ad[:landing_page_views] %></td>
                <td class="adm-num text-right"><%= ad[:checkouts] %></td>
                <td class="adm-num text-right"><%= ad[:sales] %><% if ad[:meta_purchases] != ad[:sales] %> <span class="text-ink-400">(Meta: <%= ad[:meta_purchases] %>)</span><% end %></td>
                <td class="adm-num text-right"><%= money(ad[:cac_cents], meta_currency) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="adm-hint mt-3">Gasto, impressões, cliques e LP views vêm da Meta; checkouts e vendas, dos pedidos (verdade). A Meta atribui por 7 dias após o clique: os números dos últimos dias ainda mudam.</p>
    <% end %>
  </section>
<% end %>
