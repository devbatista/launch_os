<% content_for :title, "Entrar — Launch OS" %>

<div class="flex min-h-full items-center justify-center bg-canvas px-4 py-12 font-admin">
  <div class="w-full max-w-sm">
    <div class="mb-6 flex items-center justify-center gap-2 text-ink-900">
      <span class="flex size-9 items-center justify-center rounded-md bg-primary-500 text-base font-bold text-white">L</span>
      <span class="text-xl font-bold tracking-tight">Launch OS</span>
    </div>

    <div class="adm-card">
      <h1 class="mb-1 text-lg font-semibold text-ink-900">Entrar no painel</h1>
      <p class="mb-5 text-sm text-ink-400">Acesso restrito ao administrador.</p>

      <%= render "admin/shared/flash" %>

      <%= form_with url: admin_login_path, class: "space-y-4" do |form| %>
        <div>
          <%= form.label :email_address, "E-mail", class: label_classes %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: input_classes %>
        </div>
        <div>
          <%= form.label :password, "Senha", class: label_classes %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: input_classes %>
        </div>
        <%= form.submit "Entrar", class: "#{button_classes(:primary)} w-full" %>
      <% end %>
    </div>
  </div>
</div>
