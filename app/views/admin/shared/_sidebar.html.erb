<%# Sidebar (spec 11, visual da 3.1): logo, seções "Loja" e "Sistema", usuário. Fixa no desktop, off-canvas no mobile
    (modules/admin/sidebar.js). Item ativo pelo controller atual. %>
<aside class="adm-sidebar" aria-label="Navegação principal">
  <div class="flex h-15 items-center justify-between border-b border-line px-5">
    <%= link_to admin_dashboard_path, class: "flex items-center gap-2 text-ink-900" do %>
      <span class="flex size-8 items-center justify-center rounded-md bg-primary-500 text-sm font-bold text-white">L</span>
      <span class="text-base font-bold tracking-tight">Launch OS</span>
    <% end %>
    <button type="button" class="rounded-md p-1 text-ink-400 hover:bg-hover hover:text-ink-900 lg:hidden" data-sidebar-close aria-label="Fechar menu"><%= icon(:close) %></button>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 py-4">
    <% active_products = controller_path.start_with?("admin/products", "admin/benefits", "admin/testimonials", "admin/faqs") %>
    <% sections = [
         [ "Loja", [
           [ :dashboard, "Dashboard", admin_dashboard_path, controller_name == "dashboards" ],
           [ :products, "Produtos", admin_products_path, active_products ],
           [ :orders, "Pedidos", admin_orders_path, controller_name == "orders" ],
           [ :clients, "Clientes", admin_clients_path, controller_name == "clients" ]
         ] ],
         [ "Sistema", [
           [ :webhooks, "Webhook events", admin_webhook_events_path, controller_name == "webhook_events" ],
           [ :sidekiq, "Sidekiq", "/admin/sidekiq", false, :external ]
         ] ]
       ] %>
    <% sections.each do |heading, items| %>
      <p class="adm-nav-heading"><%= heading %></p>
      <ul class="space-y-0.5">
        <% items.each do |icon_name, label, path, active, external| %>
          <% if external %>
            <li><a href="<%= path %>" target="_blank" rel="noopener" class="adm-nav-link"><%= icon(icon_name) %><span><%= label %></span><%= icon(:external, class: "ml-auto size-4!") %></a></li>
          <% else %>
            <li><%= link_to path, class: "adm-nav-link #{'adm-nav-link-active' if active}", "aria-current": (active ? "page" : nil) do %><%= icon(icon_name) %><span><%= label %></span><% end %></li>
          <% end %>
        <% end %>
      </ul>
    <% end %>
  </nav>

  <div class="border-t border-line px-5 py-4">
    <p class="truncate text-sm font-medium text-ink-900"><%= Current.user.name %></p>
    <p class="truncate text-xs text-ink-400" title="<%= Current.user.email_address %>"><%= Current.user.email_address %></p>
    <%= button_to admin_logout_path, method: :delete, class: "mt-3 flex cursor-pointer items-center gap-1.5 text-sm text-ink-400 hover:text-danger-600" do %><%= icon(:logout, class: "size-4!") %> Sair<% end %>
  </div>
</aside>
