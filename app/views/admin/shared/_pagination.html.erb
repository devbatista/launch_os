<%# Navegação de página preservando os filtros da query string. Local: page (Admin::Paginated::Page). %>
<% if page.total > page.per %>
  <nav class="flex items-center justify-between px-4 py-3 text-sm text-gray-600" aria-label="Paginação">
    <p><%= page.from %>–<%= page.to %> de <%= page.total %></p>
    <div class="flex gap-2">
      <% if page.prev %>
        <%= link_to "← Anterior", url_for(request.query_parameters.merge(page: page.prev)), class: button_classes(:small) %>
      <% end %>
      <span class="px-2 py-1 text-xs">Página <%= page.number %> de <%= page.pages %></span>
      <% if page.next %>
        <%= link_to "Próxima →", url_for(request.query_parameters.merge(page: page.next)), class: button_classes(:small) %>
      <% end %>
    </div>
  </nav>
<% elsif page.total.positive? %>
  <p class="px-4 py-3 text-sm text-gray-500"><%= page.total %> <%= page.total == 1 ? "registro" : "registros" %></p>
<% end %>
