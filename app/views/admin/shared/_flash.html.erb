<% { alert: [ :danger, :alert ], notice: [ :success, :check ] }.each do |key, (tone, icon_name)| %>
  <% next if flash[key].blank? %>
  <div id="<%= key %>" role="<%= key == :alert ? 'alert' : 'status' %>" class="adm-alert adm-alert-<%= tone %>">
    <%= icon(icon_name, class: "mt-0.5 shrink-0") %>
    <p class="font-medium"><%= flash[key] %></p>
  </div>
<% end %>
