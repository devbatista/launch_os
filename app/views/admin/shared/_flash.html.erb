<% if flash[:alert].present? %>
  <p id="alert" role="alert" class="mb-4 rounded-md bg-red-50 px-3 py-2 text-sm font-medium text-red-700"><%= flash[:alert] %></p>
<% end %>
<% if flash[:notice].present? %>
  <p id="notice" role="status" class="mb-4 rounded-md bg-green-50 px-3 py-2 text-sm font-medium text-green-700"><%= flash[:notice] %></p>
<% end %>
