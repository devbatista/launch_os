<%# Bloco 10 — CTA final: repete a promessa e leva para #buy. %>
<section class="mx-auto max-w-3xl px-4 py-14 text-center">
  <h2 class="text-2xl font-bold sm:text-3xl"><%= product.headline %></h2>
  <% if product.subheadline.present? %><p class="mt-3 text-lg text-slate-600"><%= product.subheadline %></p><% end %>
  <a href="#buy" class="mt-8 inline-flex w-full items-center justify-center rounded-lg bg-emerald-700 px-8 py-4 text-lg font-bold text-white shadow-lg transition hover:bg-emerald-600 focus:outline-none focus-visible:ring-4 focus-visible:ring-emerald-300 sm:w-auto">
    <%= product.cta_text %> — <%= money(product.price_cents, product.currency) %>
  </a>
</section>
