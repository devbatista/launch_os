<%# Bloco 1 — hero: headline, subheadline, imagem (mockup ou capa) e CTA primário para #buy. Única imagem eager (LCP). %>
<section id="hero" class="bg-slate-900 text-white">
  <div class="mx-auto grid max-w-5xl items-center gap-10 px-4 py-14 sm:py-20 md:grid-cols-2">
    <div class="text-center md:text-left">
      <h1 class="text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl lg:text-5xl"><%= product.headline %></h1>
      <% if product.subheadline.present? %>
        <p class="mt-4 text-lg text-slate-300 sm:text-xl"><%= product.subheadline %></p>
      <% end %>
      <a href="#buy" class="mt-8 inline-flex w-full items-center justify-center rounded-lg bg-emerald-500 px-8 py-4 text-lg font-bold text-slate-900 shadow-lg transition hover:bg-emerald-400 focus:outline-none focus-visible:ring-4 focus-visible:ring-emerald-300 sm:w-auto">
        <%= product.cta_text %> — <%= money(product.price_cents, product.currency) %>
      </a>
      <p class="mt-3 text-sm text-slate-400">Instant download · PDF · <%= product.refund_days %>-day money-back guarantee</p>
    </div>
    <div class="mx-auto w-full max-w-sm md:max-w-none">
      <% if product.hero_image.attached? %>
        <%= lp_image_tag product.hero_image, :lp, limit: [ 900, 900 ], alt: product.name, loading: "eager", fetchpriority: "high",
                         class: "mx-auto h-auto w-full rounded-xl object-contain drop-shadow-2xl" %>
      <% end %>
    </div>
  </div>
</section>
