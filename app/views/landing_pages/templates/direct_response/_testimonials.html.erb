<%# Bloco 6 — depoimentos. %>
<section class="mx-auto max-w-3xl px-4 py-14">
  <h2 class="text-2xl font-bold sm:text-3xl">What readers say</h2>
  <ul class="mt-8 space-y-6">
    <% product.testimonials.each do |testimonial| %>
      <li class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <blockquote class="text-lg leading-relaxed text-slate-700">“<%= testimonial.quote %>”</blockquote>
        <p class="mt-4 font-semibold"><%= testimonial.author_name %><% if testimonial.author_role.present? %><span class="font-normal text-slate-500"> · <%= testimonial.author_role %></span><% end %></p>
      </li>
    <% end %>
  </ul>
</section>
