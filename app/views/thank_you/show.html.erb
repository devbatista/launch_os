<%# Thank You (spec 08, decisão 18/09): confirma o pagamento e diz para onde o link foi — nunca mostra o link. %>
<% content_for :title, "Thank you — #{@product.name}" %>
<% content_for :head do %>
  <meta name="robots" content="noindex,nofollow">
<% end %>

<main class="mx-auto max-w-2xl px-4 py-12 sm:py-16">
  <% if @order.pending? %>
    <section class="rounded-xl border border-amber-200 bg-amber-50 p-8 text-center">
      <h1 class="text-2xl font-bold sm:text-3xl">Your payment is being processed</h1>
      <p class="mt-4 text-lg text-slate-700">PayPal is still confirming your payment for <strong><%= @product.name %></strong>. You'll get an email with your download link as soon as it clears — usually within a few minutes, sometimes up to a day. No need to pay again.</p>
      <p class="mt-6 text-sm text-slate-500">Questions? <a href="mailto:<%= support_email %>" class="underline"><%= support_email %></a></p>
    </section>

  <% elsif @order.paid? %>
    <section class="text-center" <% if @track_purchase %>data-module="tracking" data-event="purchase" data-event-id="<%= @order.event_id %>" data-value="<%= @order.amount %>" data-currency="<%= @order.currency %>" data-product-id="<%= @product.id %>"<% end %>>
      <p class="text-sm font-semibold uppercase tracking-wide text-emerald-700">Payment confirmed</p>
      <h1 class="mt-2 text-3xl font-extrabold sm:text-4xl">Thank you<%= ", #{@order.client&.name.to_s.split.first}" if @order.client&.name.present? %>!</h1>
      <p class="mt-3 text-lg text-slate-600">Your copy of <strong><%= @product.name %></strong> is on its way.</p>

      <% if @product.hero_image.attached? %>
        <%= lp_image_tag @product.hero_image, :lp, limit: [ 900, 900 ], alt: @product.name, loading: "eager", class: "mx-auto mt-8 h-auto w-full max-w-xs rounded-xl object-contain drop-shadow-xl" %>
      <% end %>

      <div class="mx-auto mt-8 max-w-lg rounded-xl border border-emerald-200 bg-emerald-50 p-6 text-left text-slate-800">
        <p class="text-lg">We're sending your download link to <strong><%= @order.client&.email || @order.payer_email %></strong><% if @order.whatsapp_opt_in? && @order.client&.whatsapp_deliverable? %> and to your WhatsApp<% end %>. It usually arrives within a minute.</p>
        <p class="mt-3 text-sm text-slate-600">Check your spam or promotions folder — the email comes from <em>@devbatista.online</em>. The link stays valid for <%= DownloadToken.ttl.in_days.to_i %> days.</p>
      </div>

      <p class="mt-6 text-sm text-slate-500">Didn't get it? <a href="/access/recover" class="underline">Resend my link</a> · <a href="mailto:<%= support_email %>" class="underline"><%= support_email %></a></p>
    </section>

  <% else %>
    <section class="rounded-xl border border-slate-200 bg-slate-50 p-8 text-center">
      <h1 class="text-2xl font-bold sm:text-3xl">This order is no longer active</h1>
      <p class="mt-4 text-lg text-slate-700">This usually happens after a failed payment, a refund or a payment dispute. If you think this is a mistake, write to us and we'll sort it out.</p>
      <p class="mt-6 text-sm text-slate-500">Support: <a href="mailto:<%= support_email %>" class="underline"><%= support_email %></a></p>
    </section>
  <% end %>
</main>
