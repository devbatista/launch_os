# Copie para .env (gitignored). Valores abaixo servem para desenvolvimento local.
# DATABASE_URL e REDIS_URL são definidos no compose.yml; em produção (Railway) vêm dos plugins.

# Portas expostas no host pelo compose.yml (mude se conflitarem com outros projetos).
# APP_HOST precisa acompanhar WEB_PORT.
WEB_PORT=3100
DB_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

APP_HOST=localhost:3100
APP_PROTOCOL=http
SUPPORT_EMAIL=support@devbatista.online
MAIL_FROM="DevBatista <no-reply@devbatista.online>"
MAIL_DOMAIN=devbatista.online

SIDEKIQ_CONCURRENCY=5

# Active Storage — MinIO em dev; R2/S3 em produção
S3_ENDPOINT=http://minio:9000
S3_BUCKET=launch-os-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# Email — em dev não precisa de nada (letter_opener_web em /letter_opener). Em produção (API do SES):
# SES_REGION=us-east-1
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_CONFIGURATION_SET=launch-os

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_TEMPLATE_ORDER_DELIVERY_SID=

META_PIXEL_ID=
GA4_MEASUREMENT_ID=
SENTRY_DSN=

DOWNLOAD_TOKEN_TTL_DAYS=7
DOWNLOAD_MAX_COUNT=10

# Seed do usuário admin (bin/rails db:seed)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@devbatista.online
ADMIN_PASSWORD=change-me-please-12
